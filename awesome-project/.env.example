# Copy to `.env` and adjust. `.env` is gitignored.

# PostgreSQL connection string.
#   scheme://user:password@host:port/database
# The `+psycopg` driver is SQLAlchemy's dialect name for psycopg 3.
# connect_timeout keeps a stopped server from hanging the app on startup.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/awesome_project?connect_timeout=10

# Log every SQL statement. Leave False normally.
SQL_ECHO=false

# Connection pool sizing (ignored by SQLite).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- auth ---------------------------------------------------------------------
# Signs session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it a random secret is generated per process, so every restart
# invalidates everyone's session.
JWT_SECRET=
JWT_EXPIRES_HOURS=12

# `true` marks the session cookie HTTPS-only. Browsers then refuse to SEND it
# over plain http, which silently logs you out everywhere except Chrome on
# localhost. Keep false while developing; set true only behind HTTPS.
COOKIE_SECURE=false

# ---- cargo detection (SAM + YOLO) ---------------------------------------------
# Off by default. The detector needs a SEPARATE virtualenv (torch, ultralytics,
# segment-anything, transformers, Open3D -- about 5.5 GB), so it cannot be
# imported here. FastAPI calls it as a subprocess instead. See DETECTION.md.
#
# Check your paths without starting the server:
#   .venv\Scripts\python.exe -m app.services.detection

DETECTION_ENABLED=false

# The detection project's python.exe -- NOT this app's.
DETECTION_PYTHON=C:\path\to\AI-Driven Cargo Detection\.venv\Scripts\python.exe

# The folder holding Revamping.ipynb and models/. Leave empty to use the
# vendored detector/ directory inside this repo (the normal case — see
# detector/README.md). Set it only to try an upstream checkout without
# re-vendoring first.
DETECTION_PROJECT_DIR=

# SAM + YOLO on CPU takes 16-45 s per image, plus model loading on the first
# call in a fresh process.
DETECTION_TIMEOUT=300

# The notebook's cells share module state and write into one project directory,
# so runs must not overlap. 1 is the safe value.
DETECTION_MAX_CONCURRENCY=1

# ---- OpenAI Decisions API (public beta, POST /v1/decisions) -----------------
# The AI step of the upload path: each upload is evaluated against a fixed,
# versioned rubric (cargo visible? which type? matches the declared type?)
# while the upload request is still open, and a *submitted* upload is
# auto-approved when every gate predicate is >= OPENAI_DECISION_MIN_CONFIDENCE.
#
# Off by default: with false (and/or no key) the upload path makes no network
# call, and the submission simply reports decision_status: "not_run".
# See docs/openai_decision_api.md.

OPENAI_DECISION_ENABLED=false

# Required when enabled. Create one at https://platform.openai.com/api-keys
# Enabling without a key records an error on the row instead of calling out.
OPENAI_API_KEY=

# /v1/decisions currently supports gpt-6-luna only.
OPENAI_DECISION_MODEL=gpt-6-luna

# Per-request timeout in seconds. A timeout (or 429/5xx after one retry) is
# stored as an error on the row and the upload proceeds to manual review --
# it never fails the upload itself.
OPENAI_DECISION_TIMEOUT=15

# Auto-approve threshold for the gate predicates, 0.0-1.0.
OPENAI_DECISION_MIN_CONFIDENCE=0.8